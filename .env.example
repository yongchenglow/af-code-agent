# AgentField Configuration
# For local development:
# AGENTFIELD_URL=http://localhost:8080
# For production:
AGENTFIELD_URL=https://agentfield.yongchenglow.com

# GitHub App Configuration
# Create a GitHub App at: https://github.com/settings/apps/new
# Required permissions:
# - Repository permissions:
#   - Contents: Read & write
#   - Pull requests: Read & write
#   - Checks: Read & write
#   - Commit statuses: Read & write
# - Subscribe to events:
#   - Pull request
#   - Check suite
GITHUB_APP_ID=your-github-app-id-here
# GitHub App private key (multi-line PEM format)
# To use multi-line in .env, replace newlines with \n
# Example: -----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
GITHUB_PRIVATE_KEY=your-github-app-private-key-here
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# AI Configuration (AgentField SDK reads these)
# For DeepSeek:
OPENAI_API_KEY=your-deepseek-api-key-here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# For OpenRouter (alternative):
# OPENROUTER_API_KEY=sk-or-v1-...
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=deepseek/deepseek-chat

# Application Settings
LOG_LEVEL=info
PORT=8001  # Default port for production deployment
