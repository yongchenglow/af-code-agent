# AgentField Configuration
# For local development:
# AGENTFIELD_URL=http://localhost:8080
# For production:
AGENTFIELD_URL=https://agentfield.yongchenglow.com

# GitHub Configuration
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# AI Configuration (AgentField SDK reads these)
# For DeepSeek:
OPENAI_API_KEY=your-deepseek-api-key-here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# For OpenRouter (alternative):
# OPENROUTER_API_KEY=sk-or-v1-...
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=deepseek/deepseek-chat

# Application Settings
LOG_LEVEL=info
PORT=8001  # Default port for production deployment
