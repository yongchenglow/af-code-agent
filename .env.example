# AgentField Configuration
AGENTFIELD_URL=http://localhost:8080

# GitHub Configuration
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# AI Configuration (AgentField SDK reads these)
# For DeepSeek:
AI_API_KEY=your-deepseek-api-key-here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# For OpenRouter (alternative):
# AI_API_KEY=sk-or-v1-...
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=deepseek/deepseek-chat

# Application Settings
LOG_LEVEL=info
PORT=8080
